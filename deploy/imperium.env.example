# /etc/imperium/imperium.env (0640 root:imperium). Secrets live only here.
IMPERIUM_ADDR=127.0.0.1:8100
IMPERIUM_DB=/var/lib/imperium/imperium.db
IMPERIUM_BASE_URL=https://imperium.hel.ink
IMPERIUM_TRUST_PROXY=1
IMPERIUM_REQUIRE_MFA=1
IMPERIUM_SESSION_HOURS=8
IMPERIUM_LANG=id
# HOP ID (LinkHop). HOP_SSO_SECRET = IMPERIUM_SSO_SECRET in LinkHop's .env (32+ chars).
HOP_URL=https://hel.ink
HOP_SSO_CLIENT=imperium
HOP_SSO_SECRET=
# Talk to HOP ID on this machine (nginx on 127.0.0.1:443, TLS name stays hel.ink).
HOP_API_ADDR=127.0.0.1:443
# Second door through Cloudflare Access: a second app ("citadel") in HOP ID's registry.
IMPERIUM_ALT_HOST=citadel.hel.ink
IMPERIUM_ALT_CLIENT=citadel
IMPERIUM_ALT_SECRET=
# Telegram alerts (app down/up, refused sign-ins): bot token and chat id. Optional.
IMPERIUM_TELEGRAM_TOKEN=
IMPERIUM_TELEGRAM_CHAT=
IMPERIUM_TELEGRAM_THREAD=
IMPERIUM_WATCH_MINUTES=2
# Hide the owner's real identity on every screen, audit row and alert.
# key = HOP ID username or email, value = the name shown instead.
#IMPERIUM_ALIASES=ivan_smb787=superadmin,ivan@example.com=superadmin
